{
  "compilerOptions": {
    "target": "es2020",
    "module": "es6",
    "lib": ["es2020", "dom"],

    "moduleResolution": "node",
    "esModuleInterop": true,

    "checkJs": false,
    "allowJs": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "noEmitOnError": true,

    "strict": false,

    "importHelpers": true,
    "inlineSources": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "removeComments": true,
    "skipLibCheck": true
  }
}
